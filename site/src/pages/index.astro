---
import Base from "../layouts/Base.astro";
import CrackedBasalt from "../components/CrackedBasalt.astro";
import KnotDivider from "../components/KnotDivider.astro";
---

<Base
  title="loki — the Odin monorepo tool"
  description="loki scaffolds, builds, and tests Odin monorepos: apps, first-party packages, and vendored git submodules, all from one CLI."
  activeNav="home"
>
  <section class="hero">
    <CrackedBasalt seed="loki-hearth-hero" />
    <div class="wrap hero-content">
      <p class="eyebrow">an odin monorepo tool</p>
      <h1 class="hero-title">One repo,<br /><span class="accent">every</span> app in it.</h1>
      <p class="hero-sub">
        loki scaffolds apps, wires up shared packages, and pins third-party
        code as git submodules — so an Odin monorepo stays one <code class="mono">odin build</code>
        away from working, no matter how many pieces it has.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#install">Install loki</a>
        <a class="btn btn-ghost" href="https://github.com/a-man-called-q/loki">View source</a>
      </div>

      <div class="terminal glow-hover">
        <div class="terminal-bar"><span>~/hearth</span><span>zsh</span></div>
        <div class="terminal-body" id="tty" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <div class="wrap"><KnotDivider seed="divider-1" /></div>

  <section id="why">
    <div class="wrap">
      <h2 class="section-title">Three directories, one tool</h2>
      <p class="section-lede">
        loki doesn't invent a new project shape — it works with the one
        every Odin monorepo already has, and automates the parts that get
        tedious by hand.
      </p>

      <div class="tree-box glow-hover">
        <pre>hearth/
├── loki.json
├── <span class="hl">apps/</span>
│   └── cli/
├── packages/
│   ├── <span class="hl">local/</span>
│   │   └── utils/
│   └── <span class="hl">vendor/</span>
│       └── some-lib/
└── bin/</pre>
      </div>

      <div class="why-grid">
        <div class="why-card glow-hover">
          <div>
            <span class="path">apps/</span>
            <p>Every binary in the repo, scaffolded the same way. <code class="mono">loki build</code> compiles one app or all of them, each to its own <code class="mono">bin/</code> output.</p>
          </div>
        </div>
        <div class="why-card glow-hover">
          <div>
            <span class="path">packages/local/</span>
            <p>First-party code shared across apps. loki discovers leaf packages by walking the tree — no manifest entry to keep in sync by hand.</p>
          </div>
        </div>
        <div class="why-card glow-hover">
          <div>
            <span class="path">packages/vendor/</span>
            <p>Third-party dependencies, pinned as git submodules. <code class="mono">loki doctor</code> catches uninitialized or drifted vendor code before it breaks a build.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap"><KnotDivider seed="divider-2" /></div>

  <section id="commands">
    <div class="wrap">
      <h2 class="section-title">Commands</h2>
      <p class="section-lede">The full surface area. Run <code class="mono">loki help</code> any time for this from the terminal.</p>
      <div class="cmd-list">
        <div class="cmd-row"><code class="mono">loki new &lt;name&gt; [--target=id,...]</code><span>Scaffold a new monorepo project</span></div>
        <div class="cmd-row"><code class="mono">loki new app &lt;name&gt; [--target=id,...]</code><span>Scaffold a new app in the current project</span></div>
        <div class="cmd-row"><code class="mono">loki new pkg &lt;name&gt;</code><span>Scaffold a new local package in the current project</span></div>
        <div class="cmd-row"><code class="mono">loki add &lt;git-url&gt; [name]</code><span>Add a third-party package as a git submodule</span></div>
        <div class="cmd-row"><code class="mono">loki sync</code><span>Init/update all vendor submodules</span></div>
        <div class="cmd-row"><code class="mono">loki run &lt;app&gt; [-- args]</code><span>Run an app</span></div>
        <div class="cmd-row"><code class="mono">loki build [app]</code><span>Build an app, or every app if omitted — per cross-compile target, if any are set</span></div>
        <div class="cmd-row"><code class="mono">loki test [target]</code><span>Test a package, or every local package if omitted</span></div>
        <div class="cmd-row"><code class="mono">loki doctor</code><span>Check that the environment — and any cross-compile toolchains — are set up correctly</span></div>
      </div>
    </div>
  </section>

  <div class="wrap"><KnotDivider seed="divider-3" /></div>

  <section id="install">
    <div class="wrap">
      <h2 class="section-title">Install</h2>
      <p class="section-lede">Needs the <a href="https://odin-lang.org/docs/install/">Odin compiler</a> (dev-2026-07 or newer) on your <code class="mono">PATH</code>. Build loki from source:</p>
      <div class="install-box glow-hover">
        <button class="copy-btn" id="copy-install" type="button">copy</button>
        <pre><span class="p">$</span> <span class="c">git clone https://github.com/a-man-called-q/loki.git</span>
<span class="p">$</span> <span class="c">cd loki</span>
<span class="p">$</span> <span class="c">./build.sh</span></pre>
      </div>
      <p class="install-note">Drop the resulting <code class="mono">bin/loki</code> on your PATH, then run <code class="mono">loki doctor</code> to confirm the environment checks out.</p>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(2.5rem, 6vw, 4rem);
  }
  .hero-content { position: relative; z-index: 1; }

  h1.hero-title {
    font-family: var(--mono);
    font-weight: 700;
    font-size: clamp(2.3rem, 6vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0 0 1.1rem;
    text-wrap: balance;
  }
  h1.hero-title .accent { color: var(--ember); }

  .hero-sub {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--ash-dim);
    max-width: 46ch;
    margin: 0 0 2.25rem;
  }

  .hero-cta { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-bottom: 3rem; }

  /* ---------- terminal ---------- */
  .terminal {
    background: color-mix(in srgb, var(--stone) 92%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--crack);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .terminal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 1rem;
    border-bottom: 1px solid var(--crack);
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--smoke);
  }
  .terminal-body {
    padding: 1.25rem 1.4rem 1.5rem;
    font-family: var(--mono);
    font-size: 0.92rem;
    min-height: 11.5em;
  }
  .terminal-body :global(.line) { white-space: pre; }
  .terminal-body :global(.prompt) { color: var(--ember); }
  .terminal-body :global(.out) { color: var(--ash-dim); }
  :global(.caret) {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    background: var(--glint);
    vertical-align: text-bottom;
    margin-left: 2px;
    animation: blink 1s step-end infinite;
  }
  @media (prefers-reduced-motion: reduce) { :global(.caret) { animation: none; } }
  @keyframes blink { 50% { opacity: 0; } }

  /* ---------- tree example ---------- */
  .tree-box {
    background: var(--stone);
    border: 1px solid var(--crack);
    border-radius: var(--radius);
    margin-bottom: 1.5rem;
    overflow: hidden;
  }
  .tree-box pre {
    margin: 0;
    padding: 1.2rem 1.4rem;
    font-family: var(--mono);
    font-size: 0.86rem;
    line-height: 1.7;
    color: var(--ash-dim);
    overflow-x: auto;
  }
  .tree-box pre :global(.hl) { color: var(--glint); font-weight: 600; }

  /* ---------- why grid ---------- */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
  }
  @media (max-width: 760px) { .why-grid { grid-template-columns: 1fr; } }
  .why-card {
    background: var(--stone);
    border: 1px solid var(--crack);
    border-radius: var(--radius);
    padding: 1.4rem 1.3rem;
    overflow: hidden;
  }
  .why-card .path {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--glint);
    background: color-mix(in srgb, var(--glint) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--glint) 30%, transparent);
    border-radius: 5px;
    padding: 0.15rem 0.5rem;
    margin-bottom: 0.8rem;
  }
  .why-card p { margin: 0; color: var(--ash-dim); font-size: 0.94rem; }

  /* ---------- commands ---------- */
  .cmd-list { border-top: 1px solid var(--crack); }
  .cmd-row {
    display: grid;
    grid-template-columns: minmax(220px, 320px) 1fr;
    gap: 1.5rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--crack);
    align-items: baseline;
  }
  @media (max-width: 640px) { .cmd-row { grid-template-columns: 1fr; gap: 0.25rem; } }
  .cmd-row code { color: var(--ember-bright); font-size: 0.88rem; }
  .cmd-row span { color: var(--ash-dim); font-size: 0.92rem; }

  /* ---------- install ---------- */
  .install-box {
    background: var(--stone);
    border: 1px solid var(--crack);
    border-radius: var(--radius);
    position: relative;
    overflow: hidden;
  }
  .install-box pre {
    margin: 0;
    padding: 1.3rem 4.2rem 1.3rem 1.4rem;
    font-family: var(--mono);
    font-size: 0.88rem;
    line-height: 1.8;
    overflow-x: auto;
    color: var(--ash-dim);
  }
  .install-box pre :global(.p) { color: var(--ember); }
  .install-box pre :global(.c) { color: var(--ash); }
  .copy-btn {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    min-width: 44px;
    min-height: 44px;
    background: var(--stone-2);
    border: 1px solid var(--crack);
    color: var(--smoke);
    font-family: var(--mono);
    font-size: 0.76rem;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    cursor: pointer;
    z-index: 1;
  }
  .copy-btn:hover { color: var(--ember-bright); border-color: var(--ember); }
  .install-note { margin: 1rem 0 0; font-size: 0.88rem; color: var(--smoke); }
</style>

<script>
  const ttyEl = document.getElementById("tty");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const script = [
    { type: "cmd", text: "loki new hearth" },
    { type: "out", text: "created hearth/" },
    { type: "cmd", text: "cd hearth && loki new app cli" },
    { type: "out", text: "created apps/cli/" },
    { type: "cmd", text: "loki new pkg utils" },
    { type: "out", text: "created packages/local/utils/" },
    { type: "cmd", text: "loki build" },
    { type: "out", text: "building cli...\nbuilt bin/cli" },
  ];

  function renderStatic() {
    if (!ttyEl) return;
    ttyEl.innerHTML = script
      .map((l) => {
        if (l.type === "cmd") return `<div class="line"><span class="prompt">$</span> ${l.text}</div>`;
        return `<div class="line out">${l.text.replace(/\n/g, '</div><div class="line out">')}</div>`;
      })
      .join("");
  }

  if (!ttyEl) {
    // no-op
  } else if (reduceMotion) {
    renderStatic();
  } else {
    let li = 0, ci = 0;
    const speed = 26;

    function step() {
      if (li >= script.length) {
        const caret = document.createElement("span");
        caret.className = "caret";
        ttyEl!.appendChild(caret);
        return;
      }
      const item = script[li];

      if (ci === 0) {
        const div = document.createElement("div");
        div.className = "line" + (item.type === "out" ? " out" : "");
        if (item.type === "cmd") {
          const p = document.createElement("span");
          p.className = "prompt";
          p.textContent = "$ ";
          div.appendChild(p);
        }
        div.appendChild(document.createTextNode(""));
        ttyEl!.appendChild(div);
      }

      const line = ttyEl!.lastChild as HTMLElement;

      if (item.type === "out") {
        line.textContent = item.text.slice(0, ci + 1);
      } else {
        const textNode = line.lastChild as Text;
        textNode.textContent = item.text.slice(0, ci + 1);
      }

      ci++;
      if (ci >= item.text.length) {
        li++;
        ci = 0;
        setTimeout(step, item.type === "out" ? 260 : 420);
      } else {
        setTimeout(step, item.type === "out" ? 6 : speed);
      }
    }

    step();
  }

  const copyBtn = document.getElementById("copy-install");
  copyBtn?.addEventListener("click", async () => {
    const cmds = "git clone https://github.com/a-man-called-q/loki.git\ncd loki\n./build.sh";
    try {
      await navigator.clipboard.writeText(cmds);
      const original = copyBtn.textContent;
      copyBtn.textContent = "copied";
      setTimeout(() => { copyBtn.textContent = original; }, 1500);
    } catch {
      // clipboard API unavailable — silently ignore
    }
  });
</script>
