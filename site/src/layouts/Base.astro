---
import "../styles/global.css";
import LokiLogo from "../components/LokiLogo.astro";

interface Props {
  title: string;
  description: string;
  activeNav?: "home" | "changelog";
}

const { title, description, activeNav } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL(`${base}/og.png`, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0d0b" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1717" />
    <meta property="og:image:height" content="916" />
    <meta property="og:image:alt" content="Loki — build every Odin app from one repo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" href={`${base}/logo.png`} />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap topbar-row">
        <a href={`${base}/`} class="wordmark" style="color: inherit;" aria-label="loki">
          <LokiLogo />
        </a>
        <nav class="topbar-links">
          <a href={`${base}/#workspace`}>docs</a>
          <a href={`${base}/changelog`} class={activeNav === "changelog" ? "current" : ""}>changelog</a>
          <a href="https://github.com/a-man-called-q/loki">github <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="wrap footer-row">
        <a href={`${base}/`} class="footer-mark" aria-label="Loki home">
          <LokiLogo />
        </a>
        <p>© {new Date().getFullYear()} Loki. Built for Odin developers.</p>
        <nav class="footer-links" aria-label="Footer">
          <a href={`${base}/#workspace`}>docs</a>
          <a href={`${base}/changelog`}>changelog</a>
          <a href="https://github.com/a-man-called-q/loki">github <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </footer>
  </body>
</html>
