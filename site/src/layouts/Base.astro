---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  activeNav?: "home" | "changelog";
}

const { title, description, activeNav } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Runic&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap topbar-row">
        <a href={`${base}/`} class="wordmark" style="color: inherit;" aria-label="loki">
          <svg class="sigil" viewBox="0 0 32 32" aria-hidden="true">
            <g transform="translate(16,16)">
              <path d="M0,0 C-4,-1 -6,-5 -5,-9 C-4,-11 -1,-12 0,-10 C1,-12 4,-11 5,-9 C6,-5 4,-1 0,0 Z" fill="var(--ember)" />
              <path d="M0,0 C-4,-1 -6,-5 -5,-9 C-4,-11 -1,-12 0,-10 C1,-12 4,-11 5,-9 C6,-5 4,-1 0,0 Z" fill="var(--ember)" opacity="0.85" transform="rotate(120)" />
              <path d="M0,0 C-4,-1 -6,-5 -5,-9 C-4,-11 -1,-12 0,-10 C1,-12 4,-11 5,-9 C6,-5 4,-1 0,0 Z" fill="var(--ember)" opacity="0.85" transform="rotate(240)" />
              <circle r="1.6" fill="var(--glint)" />
            </g>
          </svg>
          <span class="runes" aria-hidden="true">ᛚᛟᚲᛁ</span>
        </a>
        <nav class="topbar-links">
          <a href={`${base}/`} class={activeNav === "home" ? "current" : ""}>home</a>
          <a href={`${base}/changelog`} class={activeNav === "changelog" ? "current" : ""}>changelog</a>
          <a href="https://github.com/a-man-called-q/loki">github</a>
          <button id="theme-toggle" type="button" aria-label="Toggle color theme">◐</button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="wrap footer-row">
        <span>loki — forged, not found</span>
        <a href="https://github.com/a-man-called-q/loki">github.com/a-man-called-q/loki</a>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var toggle = document.getElementById("theme-toggle");
        var stored = localStorage.getItem("loki-theme");
        if (stored) root.setAttribute("data-theme", stored);

        toggle.addEventListener("click", function () {
          var current = root.getAttribute("data-theme");
          var next;
          if (!current) {
            var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
            next = prefersDark ? "light" : "dark";
          } else {
            next = current === "dark" ? "light" : "dark";
          }
          root.setAttribute("data-theme", next);
          localStorage.setItem("loki-theme", next);
        });
      })();

      (function () {
        var glowEls = document.querySelectorAll(".glow-hover");
        glowEls.forEach(function (el) {
          el.addEventListener("pointermove", function (e) {
            var rect = el.getBoundingClientRect();
            el.style.setProperty("--mx", (e.clientX - rect.left) + "px");
            el.style.setProperty("--my", (e.clientY - rect.top) + "px");
          });
        });
      })();
    </script>
  </body>
</html>
