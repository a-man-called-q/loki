---
import { linkHorizontal } from "d3-shape";

interface Props {
  class?: string;
  animated?: boolean;
}

const { class: className, animated = true } = Astro.props;

const graphHeight = 400;
const graphStartX = 18;
const graphEndX = 335;
const routeWidth = graphEndX - graphStartX;
const curveStartX = graphStartX + routeWidth / 6;
const curveEndX = graphStartX + (routeWidth * 5) / 6;

const nodes = [
  { id: "web", label: "app/web", kind: "cube", tone: "green", y: 32 },
  { id: "cli", label: "app/cli", kind: "terminal", tone: "green", y: 116 },
  { id: "log", label: "pkg/log", kind: "cube", tone: "gold", y: 200 },
  { id: "http", label: "pkg/http", kind: "cube", tone: "gold", y: 284 },
  { id: "vendor", label: "vendor/xyz", kind: "lock", tone: "green", y: 368 },
];

const links = [
  { sourceY: 32, target: "log", colors: ["#125b37", "#62e494"] },
  { sourceY: 99.2, target: "http", colors: ["#47d67f", "#efbd4d"] },
  { sourceY: 166.4, target: "vendor", colors: ["#197443", "#f0c451"] },
  { sourceY: 233.6, target: "web", colors: ["#efbd4d", "#55df8b"] },
  { sourceY: 300.8, target: "cli", colors: ["#2fbd6d", "#0f6738"] },
  { sourceY: 368, target: "log", colors: ["#d79b35", "#62e494"] },
].map((link) => ({
  ...link,
  source: [graphStartX, link.sourceY] as [number, number],
  target: [graphEndX, nodes.find((node) => node.id === link.target)!.y] as [number, number],
}));

const makeLink = linkHorizontal<any, [number, number]>()
  .x((point) => point[0])
  .y((point) => point[1]);

const renderedLinks = links.map((link) => {
  const curvedSection = makeLink({
    source: [curveStartX, link.source[1]],
    target: [curveEndX, link.target[1]],
  }) ?? "";
  const curve = curvedSection.slice(curvedSection.indexOf("C"));

  return {
    ...link,
    path: `M${link.source[0]},${link.source[1]}H${curveStartX}${curve}H${link.target[0]}`,
  };
});
---

<figure class:list={["dependency-graph", { animated }, className]} aria-label="Apps and packages connected inside one Loki workspace">
  <svg class="routes" viewBox="0 0 520 400" role="img" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
    <defs>
      {renderedLinks.map((link, index) => (
        <linearGradient
          id={`route-gradient-${index}`}
          gradientUnits="userSpaceOnUse"
          x1={link.source[0]}
          y1={link.source[1]}
          x2={link.target[0]}
          y2={link.target[1]}
        >
          <stop offset="0" stop-color={link.colors[0]} />
          <stop offset="1" stop-color={link.colors[1]} />
        </linearGradient>
      ))}
    </defs>

    <g fill="none" stroke-linecap="butt">
      {renderedLinks.map((link, index) => (
        <g class="route-layer">
          <path
            class="route-shadow"
            d={link.path}
            transform="translate(0 2)"
          />
          <path
            class:list={["route", `route-${index + 1}`]}
            style={`stroke: url(#route-gradient-${index})`}
            stroke-width="22"
            pathLength="1"
            d={link.path}
          />
        </g>
      ))}
    </g>
  </svg>

  <div class="node-list" aria-hidden="true">
    {nodes.map((node) => (
      <div class:list={["node", node.tone]} style={`--node-top: ${(node.y / graphHeight) * 100}%`}>
        <span class="node-icon">
          {node.kind === "terminal" ? (
            <svg viewBox="0 0 24 24"><path d="m6 8 4 4-4 4M13 16h5" /></svg>
          ) : node.kind === "lock" ? (
            <svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
          ) : (
            <svg viewBox="0 0 24 24"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="m4.5 7.8 7.5 4.3 7.5-4.3M12 12v9" /></svg>
          )}
        </span>
        <span class="node-label">{node.label}</span>
      </div>
    ))}
  </div>
</figure>

<style>
  .dependency-graph {
    position: relative;
    width: min(100%, 640px);
    aspect-ratio: 1.3;
    margin: 0;
    overflow: hidden;
    color: #e8eee9;
  }
  .routes { width: 100%; height: 100%; display: block; overflow: visible; }
  .route-shadow { stroke: #000; stroke-width: 27; opacity: .62; }
  .node-list { position: absolute; inset: 0; pointer-events: none; }
  .node {
    --node-color: #62e494;
    position: absolute;
    top: var(--node-top);
    left: 65.5%;
    display: flex;
    align-items: center;
    gap: clamp(.55rem, 1.4vw, .9rem);
    transform: translateY(-50%);
    white-space: nowrap;
  }
  .node.gold { --node-color: #efbd4d; }
  .node-icon {
    display: grid;
    place-items: center;
    width: clamp(34px, 5.5vw, 46px);
    height: clamp(34px, 5.5vw, 46px);
    border: 1px solid color-mix(in srgb, var(--node-color) 40%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--node-color) 5%, #0a0f0c);
    box-shadow: 0 0 24px color-mix(in srgb, var(--node-color) 9%, transparent);
  }
  .node-icon svg { width: 56%; fill: none; stroke: var(--node-color); stroke-width: 1.45; stroke-linecap: round; stroke-linejoin: round; }
  .node-label { color: #c8d1cb; font: 500 clamp(.64rem, 1.65vw, .88rem)/1 var(--mono); }

  .animated .route {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw-route .9s cubic-bezier(.5, 0, .2, 1) forwards;
  }
  .animated .route-2 { animation-delay: .08s; }
  .animated .route-3 { animation-delay: .16s; }
  .animated .route-4 { animation-delay: .24s; }
  .animated .route-5 { animation-delay: .32s; }
  .animated .route-6 { animation-delay: .4s; }
  .animated .node { opacity: 0; animation: reveal-node .45s ease-out .65s forwards; }
  .animated .node:nth-child(2) { animation-delay: .73s; }
  .animated .node:nth-child(3) { animation-delay: .81s; }
  .animated .node:nth-child(4) { animation-delay: .89s; }
  .animated .node:nth-child(5) { animation-delay: .97s; }
  @keyframes draw-route { to { stroke-dashoffset: 0; } }
  @keyframes reveal-node { from { opacity: 0; transform: translate(-8px, -50%); } to { opacity: 1; transform: translate(0, -50%); } }
  @media (prefers-reduced-motion: reduce) {
    .animated .route, .animated .node { animation: none; opacity: 1; stroke-dashoffset: 0; }
  }
  @media (max-width: 520px) {
    .node { left: 64%; }
    .node-label { font-size: .61rem; }
  }
</style>
