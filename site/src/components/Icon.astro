---
type IconName = "leaf" | "users" | "world" | "github" | "terminal" | "copy" | "folder" | "file";

interface Props {
  name: IconName;
}

const { name } = Astro.props;

const icons = import.meta.glob<string>("../icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const svg = icons[`../icons/${name}.svg`];
if (!svg) throw new Error(`Icon "${name}" not found in src/icons`);
---

<Fragment set:html={svg} />
